FROM python:3.13-slim

WORKDIR /workspace

COPY --from=ghcr.io/astral-sh/uv:0.11.8 /uv /usr/local/bin/uv

# Keep the venv outside /workspace: the host folder is bind-mounted over
# /workspace at runtime, which would hide the venv built here (and on Windows
# collide with a host-created .venv containing Scripts\ instead of bin/).
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
ENV UV_LINK_MODE=copy

# Install dependencies from lock file for reproducible builds.
# The project source is mounted at runtime, so we only need pyproject + lock here.
COPY pyproject.toml .python-version uv.lock README.md ./
RUN uv sync --frozen

COPY infrastructure/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

# Entrypoint auto-generates protobuf stubs then delegates to uv run <cmd>.
ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
